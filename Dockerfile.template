# syntax=docker/dockerfile:1.7

# Build arguments for version pinning and reproducibility
ARG BASE_VERSION=3.24.3
ARG BASE_HASH=be2656061b536c1883c4034790e21d0a09c5aaaf51968b89368a3c0371ea2c9a
FROM alpine:${BASE_VERSION}@sha256:${BASE_HASH} AS builder
ARG TARGETARCH
ARG OPENSSL_VERSION
ARG APP_VERSION

ENV CCACHE_DIR=/root/.cache/ccache \
    CCACHE_BASEDIR=/tmp \
    CCACHE_COMPILERCHECK=content \
    CCACHE_MAXSIZE=2G
SHELL ["/bin/ash", "-euo", "pipefail", "-c"]
ENV CC=clang \
    CXX=clang++ \
    LD=lld \
    AR=llvm-ar \
    NM=llvm-nm \
    RANLIB=llvm-ranlib \
    STRIP=llvm-strip

WORKDIR /tmp
# System setup and dependency installation
RUN addgroup --system --gid "10001" nginx && adduser --disabled-password --shell /bin/false --ingroup nginx --uid "10001" --no-create-home nginx \
    # Install build dependencies
    && apk add -q --no-cache \
        clang22=22.1.3-r2 \
        clang22-dev=22.1.3-r2 \
        lld22=22.1.3-r0 \
        llvm=22-r0 \
        make=4.4.1-r4 \
        git=2.54.0-r0 \
        mimalloc2-dev=2.2.7-r0 \
        build-base=0.5-r4 \
        ca-certificates=20261020-r0 \
        ccache=4.13.6-r0 \
        linux-headers=7.0.0-r1 \
        upx=5.2.0-r0 \
        perl=5.42.2-r1 \
        cmake=4.2.3-r0 \
        zstd-dev=1.5.7-r2 \
        zstd-static=1.5.7-r2 \
        brotli-dev=1.2.1-r0 \
        brotli-static=1.2.1-r0 \
        autoconf=2.73-r0 \
        automake=1.18.1-r1 \
        libtool=2.6.0-r1 \
        python3-dev=3.14.10-r1 \
        cargo=1.96.1-r0 \
        rust=1.96.1-r0 \
        pkgconf=2.5.1-r0 \
    && update-ca-certificates \
    && git config --global advice.detachedHead false \
    && PCRE_VERSION=$(git ls-remote --tags --refs https://github.com/PCRE2Project/pcre2 'pcre2-*' | grep -v -- '-RC' | sed 's|.*/||' | tail -1) \
    && ZLIB_VERSION=$(git ls-remote --tags --refs https://github.com/zlib-ng/zlib-ng | sed 's|.*/||' | sed 's/^v//' | sort -V | tail -1) \
    && ACME_VERSION=$(git ls-remote --tags --refs https://github.com/nginx/nginx-acme 'v*' | sed 's|.*/||' | sort -V | tail -1) \
    # Clone NGINX webserver and remove documentation
    && git clone -q --depth 1 --recursive -j8 --single-branch -b "release-${APP_VERSION}" https://github.com/nginx/nginx && rm -rf /tmp/nginx/docs/html/* \
    # Clone OpenSSL with HTTP/3 and QUIC support
    && git clone -q --depth 1 --recursive -j8 --single-branch -b "openssl-${OPENSSL_VERSION}" https://github.com/openssl/openssl \
    # Clone PCRE2 for regex with JIT support
    && git clone -q --depth 1 --recursive -j8 --single-branch -b "${PCRE_VERSION}" https://github.com/PCRE2Project/pcre2 \
    # Clone zlib-ng for modern compression performance
    && git clone -q --depth 1 --recursive -j8 --single-branch -b "${ZLIB_VERSION}" https://github.com/zlib-ng/zlib-ng \
    # Clone Brotli compression module
    && git clone -q --depth 1 --recurse-submodules -j8 https://github.com/google/ngx_brotli \
    # Clone headers-more module for response header clearing
    && git clone -q --depth 1 --recurse-submodules -j8 https://github.com/openresty/headers-more-nginx-module \
    # Clone ZSTD compression module (use HEAD: v0.1.1 has a bug where block size is set
    # before sub_filter body phase runs, producing corrupted output when sub_filter is active)
    && git clone -q --depth 1 --recursive -j8 https://github.com/tokers/zstd-nginx-module \
    # Clone ACME module
    && git clone -q --depth 1 --recursive -j8 --single-branch -b "${ACME_VERSION}" https://github.com/nginx/nginx-acme \
    # Remove Server header from HTTP responses (HTTP/1.1, HTTP/2, HTTP/3)
    && sed -ie 's@r->headers_out.server == NULL@0@g' \
        /tmp/nginx/src/http/ngx_http_header_filter_module.c \
        /tmp/nginx/src/http/v2/ngx_http_v2_filter_module.c \
        /tmp/nginx/src/http/v3/ngx_http_v3_filter_module.c \
    # Remove default footer from error pages
    && sed -ie 's@<hr><center>nginx</center>@@g' /tmp/nginx/src/http/ngx_http_special_response.c

# Build zlib-ng and Brotli compression libraries with optimizations
WORKDIR /tmp/zlib-ng
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    mkdir -p /tmp/ngx_brotli/deps/brotli/out \
    && case "${TARGETARCH}" in \
        amd64) ARCH_FLAGS="-m64 -march=x86-64 -mtune=generic" ;; \
        arm64) ARCH_FLAGS="-march=armv8-a" ;; \
        *) ARCH_FLAGS="" ;; \
    esac \
    # Configure Brotli with performance optimizations
    && cmake -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=OFF \
        -DCMAKE_C_COMPILER=clang \
        -DCMAKE_CXX_COMPILER=clang++ \
        -DCMAKE_C_COMPILER_LAUNCHER=ccache \
        -DCMAKE_CXX_COMPILER_LAUNCHER=ccache \
        -DCMAKE_C_FLAGS="${ARCH_FLAGS} -flto -funroll-loops -ffunction-sections -fdata-sections -Wl,--gc-sections" \
        -DCMAKE_CXX_FLAGS="${ARCH_FLAGS} -flto -funroll-loops -ffunction-sections -fdata-sections -Wl,--gc-sections" \
        -DCMAKE_INSTALL_PREFIX=./installed -B /tmp/ngx_brotli/deps/brotli/out -S /tmp/ngx_brotli/deps/brotli \
    # Build Brotli encoder
    && cmake --build /tmp/ngx_brotli/deps/brotli/out --config Release --target brotlienc \
    # Configure zlib-ng for compatibility mode
    && sed -i "s/compat=0/compat=1/" /tmp/zlib-ng/configure && CC="ccache clang" ./configure --zlib-compat \
    # Build and install zlib-ng
    && make -s -j "$(nproc)" && make -s install && make -s clean

# Build PCRE2 as static library
WORKDIR /tmp/pcre2
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    case "${TARGETARCH}" in \
        amd64) ARCH_FLAGS="-march=x86-64 -fcf-protection=full" ;; \
        arm64) ARCH_FLAGS="-march=armv8-a" ;; \
        *) ARCH_FLAGS="" ;; \
    esac \
    && ./autogen.sh \
    && CC="ccache clang" CFLAGS="-fPIC -O3 ${ARCH_FLAGS} -fstack-protector-strong \
    -fvisibility=hidden -flto=full" \
       ./configure \
        --disable-shared \
        --enable-static \
        --enable-pcre2-8 \
        --enable-unicode \
        --enable-jit \
    && make -s -j "$(nproc)" && make -s install && make -s clean

# Build OpenSSL as static library
WORKDIR /tmp/openssl
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    case "${TARGETARCH}" in \
        amd64) OPENSSL_TARGET="linux-x86_64"; OPENSSL_ARCH_OPT="enable-ec_nistp_64_gcc_128" ;; \
        arm64) OPENSSL_TARGET="linux-aarch64"; OPENSSL_ARCH_OPT="" ;; \
        *) OPENSSL_TARGET="linux-generic64"; OPENSSL_ARCH_OPT="" ;; \
    esac \
    && CC="ccache clang" ./Configure \
        "${OPENSSL_TARGET}" \
        ${OPENSSL_ARCH_OPT} \
        no-tls1 \
        no-tls1_1 \
        no-shared \
        no-weak-ssl-ciphers \
        enable-quic \
        enable-ktls \
        zlib \
        --prefix=/tmp/openssl/.openssl \
        --libdir=lib \
        --openssldir=/tmp/openssl/.openssl \
    && make -s -j "$(nproc)" && make -s install_sw && make -s clean

# Configure and build NGINX with security hardening and optimizations
WORKDIR /tmp/nginx
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    export CC="ccache clang" CXX="ccache clang++" LD="lld" AR="llvm-ar" \
        NM="llvm-nm" RANLIB="llvm-ranlib" STRIP="llvm-strip" \
    && case "${TARGETARCH}" in \
        amd64) OPENSSL_ARCH_OPT="enable-ec_nistp_64_gcc_128"; CC_ARCH_OPT="-march=x86-64"; CONTROL_FLOW_OPT="-fcf-protection=full"; LD_ARCH_OPT="-Wl,-z,shstk" ;; \
        arm64) OPENSSL_ARCH_OPT=""; CC_ARCH_OPT="-march=armv8-a"; CONTROL_FLOW_OPT=""; LD_ARCH_OPT="" ;; \
        *) OPENSSL_ARCH_OPT=""; CC_ARCH_OPT=""; CONTROL_FLOW_OPT=""; LD_ARCH_OPT="" ;; \
    esac \
    && ./auto/configure \
        --with-debug \
        # Installation paths
        --prefix="/etc/nginx" \
        --sbin-path="/usr/sbin/nginx" \
        --user="nginx" \
        --group="nginx" \
        --http-log-path="/dev/stdout" \
        --error-log-path="/dev/stderr" \
        --conf-path="/etc/nginx/nginx.conf" \
        --pid-path="/tmp/nginx.pid" \
        --lock-path="/tmp/nginx.lock" \
        --http-client-body-temp-path="/tmp/client_temp" \
        --http-proxy-temp-path="/tmp/proxy_temp" \
        --http-fastcgi-temp-path="/tmp/fastcgi_temp" \
        # SSL/TLS configuration with modern protocols
        --with-openssl="/tmp/openssl" \
        --with-openssl-opt="\
            ${OPENSSL_ARCH_OPT} \
            no-tls1 \
            no-tls1_1 \
            no-shared \
            no-weak-ssl-ciphers \
            enable-quic \
            enable-ktls \
            zlib" \
        # External libraries
        --with-pcre="/tmp/pcre2" \
        --with-zlib="/tmp/zlib-ng" \
        --with-cc="$CC" \
        # Compilation flags
        --with-cc-opt="\
            -fPIE \
            -O3 \
            ${CC_ARCH_OPT} \
            -flto=full \
            -Wall \
            -Wextra \
            -Wformat=2 \
            -Wimplicit-fallthrough \
            -Werror=format-security \
            -Werror=return-type \
            -Wno-unused-parameter \
            -Wno-implicit-fallthrough \
            -Wno-sign-compare \
            -Wno-deprecated-declarations \
            -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=3 -D_GLIBCXX_ASSERTIONS \
            -fstrict-flex-arrays=3 -fstack-clash-protection -fstack-protector-strong \
            ${CONTROL_FLOW_OPT} -ftrivial-auto-var-init=pattern \
            -fno-delete-null-pointer-checks -fno-strict-overflow \
            -fasynchronous-unwind-tables -fomit-frame-pointer \
            -DTCP_FASTOPEN=23" \
        --with-ld-opt="-fuse-ld=lld -flto=full -L/usr/local/lib -lz -static-pie \
            -Wl,-z,nodlopen -Wl,-z,noexecstack -Wl,-z,relro -Wl,-z,now \
            -Wl,-z,separate-code ${LD_ARCH_OPT} \
            -Wl,--as-needed -Wl,--no-copy-dt-needed-entries" \
        # Core features
        --with-compat \
        --with-pcre-jit \
        --with-threads \
        # HTTP modules
        --with-http_realip_module \
        --with-http_stub_status_module \
        --with-http_ssl_module \
        --with-http_v2_module \
        --with-http_v3_module \
        --with-http_sub_module \
        --with-http_gzip_static_module \
        # Stream modules
        --with-stream \
        --with-stream_realip_module \
        --with-stream_ssl_module \
        --with-stream_ssl_preread_module \
        # Remove unnecessary modules to reduce attack surface
        --without-stream_split_clients_module \
        --without-stream_set_module \
        --without-http_geo_module \
        --without-http_scgi_module \
        --without-http_uwsgi_module \
        --without-http_autoindex_module \
        --without-http_split_clients_module \
        --without-http_memcached_module \
        --without-http_ssi_module \
        --without-http_empty_gif_module \
        --without-http_browser_module \
        --without-http_userid_module \
        --without-http_mirror_module \
        --without-http_referer_module \
        --without-mail_pop3_module \
        --without-mail_imap_module \
        --without-mail_smtp_module \
        # Third-party modules
        --add-module="/tmp/ngx_brotli" \
        --add-module="/tmp/headers-more-nginx-module" \
        --add-module="/tmp/zstd-nginx-module" \
        --add-module="/tmp/nginx-acme" \
    # Swap zstd before brotli in filter chain so zstd takes priority when client supports both.
    # Both modules insert themselves after gzip via the same sed pattern; brotli runs first
    # (so zstd lands between gzip and brotli). Swapping here puts zstd after brotli → LIFO
    # means zstd runs first and wins when Accept-Encoding contains both br and zstd.
    && perl -0777 -i -pe \
        's/&ngx_http_zstd_filter_module,(\n\s+)&ngx_http_brotli_filter_module,/&ngx_http_brotli_filter_module,$1&ngx_http_zstd_filter_module,/g' \
        objs/ngx_modules.c

# Global ENVs for OpenSSL
ENV OPENSSL_DIR="/tmp/openssl/.openssl" \
    OPENSSL_INCLUDE_DIR="/tmp/openssl/.openssl/include" \
    OPENSSL_LIB_DIR="/tmp/openssl/.openssl/lib" \
    PKG_CONFIG_PATH="/tmp/openssl/.openssl/lib/pkgconfig"

# Build ACME module for NGINX
WORKDIR /tmp/nginx-acme
RUN NGINX_BUILD_DIR="$(realpath ../nginx/objs)" \
    && export NGINX_BUILD_DIR && cargo build --release

# Build and install NGINX
WORKDIR /tmp/nginx
RUN --mount=type=cache,target=/root/.cache/ccache,sharing=locked \
    make -s -j "$(nproc)" && make -s install \
    && file objs/src/http/ngx_http.o objs/src/core/nginx.o | grep -i 'LLVM IR bitcode' && make -s clean \
    # Security hardening: strip debug symbols and compress binary
    && file /usr/sbin/nginx \
    && readelf --program-headers --wide /usr/sbin/nginx > /tmp/nginx-program-headers \
    && readelf --dynamic --wide /usr/sbin/nginx > /tmp/nginx-dynamic-section \
    && ! grep -q 'INTERP' /tmp/nginx-program-headers \
    && ! grep -q '(NEEDED)' /tmp/nginx-dynamic-section \
    && llvm-strip --strip-all /usr/sbin/nginx \
    && upx -qq --best --lzma /usr/sbin/nginx \
    && ls -lash /usr/sbin/nginx && /usr/sbin/nginx -V \
    # Set proper permissions
    && chown -R "10001:10001" /etc/nginx && rm -rf /tmp/* \
    && grep -E "(root|nginx)" /etc/passwd > /tmp/passwd \
    && grep -E "(root|nginx)" /etc/group > /tmp/group \
    && grep -E "(root|nginx)" /etc/shadow > /tmp/shadow \
    && install -d -o "10001" -g "10001" -m 700 \
        /tmp/runtime-tmp \
        /tmp/runtime-tmp/client_temp \
        /tmp/runtime-tmp/proxy_temp \
        /tmp/runtime-tmp/proxy_temp_path \
        /tmp/runtime-tmp/fastcgi_temp \
    && find /etc/nginx -type d -exec chmod 550 {} \; \
    && find /etc/nginx -type f -name "*.conf" -exec chmod 440 {} \; \
    && find /etc/nginx -type f -name "*.types" -exec chmod 440 {} \; \
    && chmod 644 /tmp/passwd /tmp/group && chmod 640 /tmp/shadow

# Final distroless image
FROM scratch
ARG APP_VERSION
ARG BUILD_DATE
ARG VCS_REF

# Copy minimal runtime dependencies from builder
WORKDIR /
COPY --from=builder --chown="0:0" /tmp/passwd /tmp/group /tmp/shadow /etc/
COPY --from=builder --chown="10001:10001" --chmod="550" /usr/sbin/nginx /usr/sbin/nginx
COPY --from=builder --chown="10001:10001" /etc/nginx /etc/nginx
COPY --from=builder --chown="10001:10001" /tmp/runtime-tmp /tmp
# Copy configuration files
COPY --chown="10001:10001" ./nginx.conf /etc/nginx/nginx.conf
COPY --chown="10001:10001" ./default.conf /etc/nginx/conf.d/default.conf

# Expose HTTP, HTTPS, and QUIC ports
EXPOSE 8080/tcp 8443/tcp 8443/udp

# OCI labels for image metadata
LABEL description="Distroless NGINX with HTTP/3, QUIC, ECH and PQC support🚀" \
      maintainer="ammnt" \
      org.opencontainers.image.description="Distroless NGINX with HTTP/3, QUIC, ECH and PQC support🚀" \
      org.opencontainers.image.authors="ammnt" \
      org.opencontainers.image.title="Distroless NGINX with HTTP/3, QUIC, ECH and PQC support🚀" \
      org.opencontainers.image.source="https://github.com/ammnt/nginx/" \
      org.opencontainers.image.created=${BUILD_DATE} \
      org.opencontainers.image.documentation="https://github.com/ammnt/nginx/blob/main/README.md" \
      org.opencontainers.image.licenses="BSD-2-Clause License" \
      org.opencontainers.image.url="https://ammnt.fun" \
      org.opencontainers.image.version=${APP_VERSION} \
      org.opencontainers.image.revision=${VCS_REF}

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD ["/usr/sbin/nginx", "-qt"]

# Use SIGQUIT for graceful shutdown with connection draining
STOPSIGNAL SIGQUIT

# Run as non-root user for security
USER 10001:10001

WORKDIR /tmp

# Start NGINX in foreground mode
ENTRYPOINT ["/usr/sbin/nginx", "-g", "daemon off;"]
